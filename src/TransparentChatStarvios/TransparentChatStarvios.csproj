<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TransparentChatStarvios</AssemblyName>
    <RootNamespace>TransparentChatStarvios</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Transparent Chat Starvios</Product>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- Bajo consumo: GC de estación de trabajo sin concurrencia y heap pequeño -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
  </ItemGroup>

</Project>
